{
  "manifest_version": 3,
  "name": "Git-Vault — Zero-Knowledge Password Vault",
  "version": "1.0.0",
  "description": "Zero Server Storage password manager encrypted with AES-256-GCM directly onto your private GitHub repository.",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://git-vault.onrender.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://git-vault.onrender.com/*",
      "http://127.0.0.1:8000/*",
      "http://localhost:8000/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Git-Vault"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
